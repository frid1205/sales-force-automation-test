<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd" >
<suite name="Sales In Application Mobile" parallel="false" thread-count="1" verbose="1">
	<parameter name="browser" value="chrome" />
	<parameter name="headless" value="false" />
	<parameter name="record" value="no" />
	<parameter name="email" value="no" />
	<parameter name="env" value="mobile" />
	<parameter name="isCloud" value="true" />

    <test name="Login Sales">
        <classes>
            <class name="mobileTestCases.Login">
    			<methods>
					<include name="loginSales"/>
    			</methods>
	    	</class>
        </classes>
    </test>
    <test name="Clock In">
        <classes>
            <class name="mobileTestCases.ClockInOut">
    			<methods>
					<include name="testClockIn"/>
    			</methods>
	    	</class>
        </classes>
    </test>
    <test name="Add Call Scheduller">
        <classes>
            <class name="mobileTestCases.AddCallScheduller">
    			<methods>
					<include name="testAddCallScheduller"/>
    			</methods>
	    	</class>
        </classes>
    </test>
    <test name="Check In Out">
        <classes>
            <class name="mobileTestCases.CheckInOut">
    			<methods>
					<include name="testCheckInOut"/>
    			</methods>
	    	</class>
        </classes>
    </test>
    <test name="Request Expenses">
        <classes>
            <class name="mobileTestCases.RequestExpenses">
    			<methods>
					<include name="testRequestExpenses"/>
    			</methods>
	    	</class>
        </classes>
    </test>
    <test name="Clock Out">
        <classes>
            <class name="mobileTestCases.ClockInOut">
    			<methods>
					<include name="testClockOut"/>
    			</methods>
	    	</class>
        </classes>
    </test>
</suite>
