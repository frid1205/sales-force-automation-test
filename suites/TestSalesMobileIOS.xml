<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd" >
<suite name="Sales In Application Mobile - iOS" parallel="false" thread-count="1" verbose="1">
	<parameter name="browser" value="safari" />
	<parameter name="headless" value="false" />
	<parameter name="record" value="no" />
	<parameter name="email" value="yes" />
	<parameter name="env" value="mobile" />
	<parameter name="platform" value="ios" />
	<parameter name="isCloud" value="true" />

    <test name="Login Sales iOS">
        <classes>
            <class name="mobileTestCases.Login">
    			<methods>
					<include name="loginSales"/>
    			</methods>
	    	</class>
        </classes>
    </test>
</suite>
