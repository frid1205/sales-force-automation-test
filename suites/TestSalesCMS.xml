<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd" >
<suite name="Sales Update Progress" parallel="false" thread-count="1" verbose="1">
	<parameter name="env" value="cms" />
    <test name="Login Sales">
        <classes>
            <class name="testCases.Login">
    			<methods>
					<include name="loginSales"/>
    			</methods>
	    	</class>
        </classes>
    </test>
    <test name="Lead Management - Sales Update progress">
        <classes>
            <class name="testCases.LeadManagement">
    			<methods>
					<include name="testEditProgressCardBySales"/>
    			</methods>
	    	</class>
        </classes>
    </test>
</suite>